# Локальная БД (по умолчанию SQLite-файл рядом с проектом)
DATABASE_URL="file:./dev.db"

# CORS для фронтенда
CORS_ORIGIN="http://localhost:3000"

# Порт API
PORT=4000

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Vision provider: mock (по умолчанию, без внешних запросов) | gemini
VISION_PROVIDER=mock

# Google Gemini API — используется при VISION_PROVIDER=gemini и как нога "gemini"
# LLM-цепочки (см. ниже). Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── LLM для разбора заявок гаффера: текст и документы (PDF/фото) ─────────────
# LLM_PROVIDER: anthropic | gemini | openai | fallback
#   fallback — цепочка из LLM_FALLBACK_CHAIN: следующая нога берёт запрос,
#   если предыдущая упала или не нашла ни одной позиции.
#   Боевая конфигурация: LLM_PROVIDER=fallback + LLM_FALLBACK_CHAIN=anthropic,gemini.
#   Для локальной разработки достаточно одной ноги — gemini.
LLM_PROVIDER=gemini
LLM_FALLBACK_CHAIN=anthropic,gemini

# Anthropic (Claude) — основная нога. Ключ: https://console.anthropic.com/settings/keys
# Позиции извлекаются structured output'ом (JSON строго по схеме — «прозы
# вместо JSON» не бывает), документы заявок читаются нативно (PDF/JPEG/PNG/WEBP).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Глубина размышления: low | medium | high | xhigh | max. Разбору списков хватает low.
ANTHROPIC_EFFORT=low

# OpenAI — только текст, документы через эту ногу не читаются.
#   "openai" (историческое имя "chatmock") — OpenAI-совместимый endpoint по
#   OPENAI_BASE_URL (локальный прокси, реселлер); без OPENAI_BASE_URL — прямой api.openai.com.
#   При прокси ключ не нужен — прокси ходит своей сессией; оставьте пустым.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
#   "openai-api" — ВСЕГДА прямой api.openai.com со своими переменными, чтобы ключ
#   и модель прокси-ноги с ними не путались. OPENAI_FALLBACK_BASE_URL — только
#   для реселлер-прокси вместо api.openai.com.
OPENAI_FALLBACK_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o
OPENAI_FALLBACK_BASE_URL=

# По умолчанию PDF использует DejaVu из apps/api/assets/fonts. При необходимости переопределите:
# SMETA_PDF_FONT_TTF="/path/to/DejaVuSans.ttf"
# SMETA_PDF_FONT_BOLD_TTF="/path/to/DejaVuSans-Bold.ttf"

# Аутентификация по API-ключу (X-API-Key header)
API_KEYS=your_api_key_here
# warn — неавторизованные запросы логируются, но пропускаются (безопасное значение по умолчанию)
# enforce — неавторизованные запросы отклоняются с 401
AUTH_MODE=warn

# ─── Реквизиты организации (для PDF Счёт и Акт) ──────────────────────────────
# Phase 1: берутся из ENV. Phase 2 переедет в /settings/organization (БД).
ORG_NAME="ООО «Световое оборудование»"
ORG_INN="7700000000"
ORG_KPP="770001001"
ORG_ADDRESS="г. Москва, ул. Примерная, д. 1, офис 101"
ORG_PHONE="+7 (495) 000-00-00"
ORG_BANK="АО «Альфа-Банк»"
ORG_BIK="044525593"
ORG_RSCHET="40702810000000000001"
ORG_KSCHET="30101810200000000593"

# DEV ONLY — skip bcrypt password check on /api/auth/login.
# When NODE_ENV !== "production" AND set to "true", any password is accepted for any AdminUser.
# DO NOT enable on production. The deploy.sh sets NODE_ENV=production, which forces this branch off.
DEV_AUTH_BYPASS=false
